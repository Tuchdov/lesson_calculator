# Browser: replace with your existing Google OAuth web client ID.
VITE_GOOGLE_CLIENT_ID=
# Server-only values below. Never prefix these names with VITE_.
ALLOWED_EMAIL=
TURSO_DATABASE_URL=file:./.billing-data/billing.db
TURSO_AUTH_TOKEN=
GROW_ENVIRONMENT=sandbox
GROW_MERCHANT_ID=
BILLING_MODE=shadow
PAYMENT_PAYLOAD_KEY=
MAKE_WEBHOOK_URL=
MAKE_API_KEY=
MAKE_RESULT_SECRET=
MAKE_NOTIFY_SECRET=
MAKE_OPERATIONS_WEBHOOK_URL=
PAYMENT_JOBS_SECRET=
# Enable only after sandbox proves replaying an acknowledgement is safe.
GROW_APPROVAL_REPLAY_SAFE=false
