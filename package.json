{
  "name": "lesson_calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:db && npm run test:hooks",
    "test:unit": "deno test",
    "test:hooks": "vitest run",
    "test:hooks:watch": "vitest",
    "preview": "vite preview",
    "test:db": "node --test tests/db/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:configure": "node --env-file-if-exists=.env.local scripts/configureBilling.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.1.3",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  }
}
